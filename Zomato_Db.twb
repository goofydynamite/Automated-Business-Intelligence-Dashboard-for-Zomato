      <aliases enabled='yes' />
      <column caption='Total Revenue' datatype='real' name='[Calculation_630504008620990464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_amount])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_630504008621113345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Unique Customers' datatype='integer' name='[Calculation_630504008621178882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='Average Order Value (AOV)' datatype='real' name='[Calculation_630504008621240323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_amount]) / COUNTD([order_id])' />
      </column>
      <column caption='Acquisition Cohort' datatype='datetime' name='[Calculation_630504008624476164]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [customer_id]: MIN(DATETRUNC(&apos;month&apos;, [order_date]))}' />
      </column>
      <column aggregation='Sum' caption='Months Since Acquisition' datatype='integer' name='[Calculation_630504008624570373]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_630504008624476164], [order_date])' />
      </column>
